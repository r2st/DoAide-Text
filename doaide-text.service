[Unit]
Description=DoAide Text - Free Text Tools
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/doaide-text
ExecStart=/usr/bin/node /opt/doaide-text/node_modules/.bin/vite preview --host 172.18.0.1 --port 3066
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
